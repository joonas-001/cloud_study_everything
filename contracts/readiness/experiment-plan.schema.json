{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://local.cloud-study/contracts/readiness/experiment-plan.schema.json",
  "title": "Local experiment plan",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "path",
    "title",
    "target_audience",
    "hypothesis",
    "planned_action",
    "success_metric",
    "time_budget_minutes",
    "cost_cap_minor",
    "stop_conditions",
    "non_offerings",
    "compliance_todos",
    "review_on"
  ],
  "properties": {
    "schema_version": { "const": "1.0.0" },
    "path": {
      "enum": ["employment", "freelancing", "productization"]
    },
    "title": { "type": "string", "minLength": 1, "maxLength": 200 },
    "target_audience": { "type": "string", "minLength": 1, "maxLength": 500 },
    "hypothesis": { "type": "string", "minLength": 1, "maxLength": 3000 },
    "planned_action": { "type": "string", "minLength": 1, "maxLength": 3000 },
    "success_metric": { "type": "string", "minLength": 1, "maxLength": 2000 },
    "time_budget_minutes": {
      "type": "integer",
      "minimum": 1,
      "maximum": 100000
    },
    "cost_cap_minor": {
      "type": "integer",
      "minimum": 0,
      "maximum": 100000000
    },
    "stop_conditions": {
      "type": "array",
      "minItems": 1,
      "maxItems": 20,
      "items": { "type": "string", "minLength": 1, "maxLength": 500 }
    },
    "non_offerings": {
      "type": "array",
      "minItems": 1,
      "maxItems": 20,
      "items": { "type": "string", "minLength": 1, "maxLength": 500 }
    },
    "compliance_todos": {
      "type": "array",
      "maxItems": 20,
      "items": { "type": "string", "minLength": 1, "maxLength": 500 }
    },
    "review_on": {
      "type": "string",
      "format": "date"
    }
  }
}
