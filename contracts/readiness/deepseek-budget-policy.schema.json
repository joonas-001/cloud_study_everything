{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://cloud-study.local/contracts/readiness/deepseek-budget-policy.schema.json",
  "title": "DeepSeek market research budget policy",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "policy_id",
    "version",
    "provider_id",
    "model_id",
    "currency",
    "pricing_source",
    "pricing_verified_at",
    "pricing_per_million_tokens",
    "limits",
    "monthly_warning_ratios",
    "automatic_top_up",
    "unknown_price_action",
    "price_change_action",
    "metadata_refresh_interval_days",
    "synthesis_interval_days",
    "synthesis_lease_minutes"
  ],
  "properties": {
    "policy_id": { "const": "deepseek-v4-flash-budget" },
    "version": { "type": "string", "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+$" },
    "provider_id": { "const": "deepseek" },
    "model_id": { "const": "deepseek-v4-flash" },
    "currency": { "const": "CNY" },
    "pricing_source": {
      "const": "https://api-docs.deepseek.com/zh-cn/quick_start/pricing"
    },
    "pricing_verified_at": { "type": "string", "format": "date" },
    "pricing_per_million_tokens": {
      "type": "object",
      "additionalProperties": false,
      "required": ["cached_input", "uncached_input", "output"],
      "properties": {
        "cached_input": { "const": 0.02 },
        "uncached_input": { "const": 1.0 },
        "output": { "const": 2.0 }
      }
    },
    "limits": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "monthly",
        "daily",
        "research_run",
        "max_input_tokens_per_call",
        "max_output_tokens_per_call"
      ],
      "properties": {
        "monthly": { "const": 5.0 },
        "daily": { "const": 0.5 },
        "research_run": { "const": 0.2 },
        "max_input_tokens_per_call": { "const": 50000 },
        "max_output_tokens_per_call": { "const": 5000 }
      }
    },
    "monthly_warning_ratios": {
      "const": [0.5, 0.8]
    },
    "automatic_top_up": { "const": false },
    "unknown_price_action": { "const": "stop" },
    "price_change_action": { "const": "stop" },
    "metadata_refresh_interval_days": { "const": 7 },
    "synthesis_interval_days": { "const": 30 },
    "synthesis_lease_minutes": { "const": 5 }
  }
}
