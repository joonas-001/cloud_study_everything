{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://local.cloud-study/contracts/readiness/independent-review.schema.json",
  "title": "Independent human review record",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "dimension",
    "reviewer_relationship",
    "review_scope",
    "rubric_id",
    "rubric_version",
    "conclusion",
    "reviewed_at"
  ],
  "properties": {
    "schema_version": { "const": "1.0.0" },
    "dimension": { "enum": ["transfer", "artifact"] },
    "reviewer_relationship": {
      "enum": ["peer", "mentor", "instructor", "employer", "client", "other"]
    },
    "review_scope": { "type": "string", "minLength": 1, "maxLength": 2000 },
    "rubric_id": { "type": "string", "minLength": 1, "maxLength": 100 },
    "rubric_version": {
      "type": "string",
      "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+$"
    },
    "conclusion": { "enum": ["passed", "needs_work"] },
    "reviewed_at": {
      "type": "string",
      "format": "date-time"
    }
  }
}
