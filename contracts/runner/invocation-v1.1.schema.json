{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://local.cloud-study/contracts/runner/invocation-v1.1.schema.json",
  "title": "Isolated runner invocation 1.1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "protocol_version",
    "audit_id",
    "artifact_sha256",
    "runtime",
    "source",
    "tests",
    "limits"
  ],
  "properties": {
    "protocol_version": {
      "const": "1.1.0"
    },
    "audit_id": {
      "type": "string",
      "format": "uuid"
    },
    "artifact_sha256": {
      "$ref": "#/$defs/sha256"
    },
    "runtime": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "version", "language", "platform", "image"],
      "properties": {
        "id": {
          "$ref": "#/$defs/stableId"
        },
        "version": {
          "$ref": "#/$defs/version"
        },
        "language": {
          "enum": ["cpp", "python"]
        },
        "platform": {
          "const": "linux/amd64"
        },
        "image": {
          "type": "string",
          "pattern": "^[a-z0-9._/-]+@sha256:[a-f0-9]{64}$"
        }
      }
    },
    "source": {
      "type": "object",
      "additionalProperties": false,
      "required": ["filename", "content"],
      "properties": {
        "filename": {
          "enum": ["main.cpp", "main.py"]
        },
        "content": {
          "type": "string",
          "minLength": 1,
          "maxLength": 65536
        }
      }
    },
    "tests": {
      "type": "array",
      "minItems": 1,
      "maxItems": 20,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "stdin", "expected_stdout"],
        "properties": {
          "id": {
            "$ref": "#/$defs/stableId"
          },
          "stdin": {
            "type": "string",
            "maxLength": 65536
          },
          "expected_stdout": {
            "type": "string",
            "maxLength": 65536
          }
        }
      }
    },
    "limits": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "compile_wall_seconds",
        "run_wall_seconds",
        "compile_memory_mb",
        "run_memory_mb",
        "cpus",
        "compile_pids",
        "run_pids",
        "output_bytes",
        "tmpfs_mb"
      ],
      "properties": {
        "compile_wall_seconds": {
          "const": 15
        },
        "run_wall_seconds": {
          "const": 3
        },
        "compile_memory_mb": {
          "const": 768
        },
        "run_memory_mb": {
          "const": 256
        },
        "cpus": {
          "const": 1
        },
        "compile_pids": {
          "const": 64
        },
        "run_pids": {
          "const": 32
        },
        "output_bytes": {
          "const": 65536
        },
        "tmpfs_mb": {
          "const": 128
        }
      }
    }
  },
  "$defs": {
    "stableId": {
      "type": "string",
      "pattern": "^[a-z][a-z0-9-]*$"
    },
    "version": {
      "type": "string",
      "pattern": "^(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)$"
    },
    "sha256": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    }
  }
}
