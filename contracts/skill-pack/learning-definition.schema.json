{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://local.cloud-study/contracts/skill-pack/learning-definition.schema.json",
  "title": "Skill package learning definition",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "id",
    "skill_id",
    "skill_version",
    "units",
    "activities",
    "diagnostic_remediation_rules"
  ],
  "properties": {
    "schema_version": {
      "enum": ["1.0.0", "2.0.0"]
    },
    "id": {
      "$ref": "#/$defs/stableId"
    },
    "skill_id": {
      "$ref": "#/$defs/stableId"
    },
    "skill_version": {
      "$ref": "#/$defs/version"
    },
    "units": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id",
          "title",
          "objective",
          "reason",
          "estimated_minutes",
          "prerequisite_unit_ids",
          "source_ids"
        ],
        "properties": {
          "id": {
            "$ref": "#/$defs/stableId"
          },
          "title": {
            "$ref": "#/$defs/nonEmpty"
          },
          "objective": {
            "$ref": "#/$defs/nonEmpty"
          },
          "reason": {
            "$ref": "#/$defs/nonEmpty"
          },
          "estimated_minutes": {
            "type": "integer",
            "minimum": 15,
            "maximum": 360
          },
          "prerequisite_unit_ids": {
            "type": "array",
            "uniqueItems": true,
            "items": {
              "$ref": "#/$defs/stableId"
            }
          },
          "source_ids": {
            "$ref": "#/$defs/idList"
          },
          "capability_ids": {
            "$ref": "#/$defs/idList"
          },
          "cognitive_load": {
            "enum": ["low", "medium", "high"]
          }
        }
      }
    },
    "activities": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id",
          "unit_id",
          "type",
          "title",
          "prompt",
          "reason",
          "estimated_minutes",
          "required",
          "completion_rule",
          "source_ids",
          "submission_fields"
        ],
        "properties": {
          "id": {
            "$ref": "#/$defs/stableId"
          },
          "unit_id": {
            "$ref": "#/$defs/stableId"
          },
          "type": {
            "enum": [
              "study",
              "explanation",
              "structured_check",
              "code_text",
              "transfer",
              "correction",
              "project_evidence",
              "review"
            ]
          },
          "title": {
            "$ref": "#/$defs/nonEmpty"
          },
          "prompt": {
            "$ref": "#/$defs/nonEmpty"
          },
          "reason": {
            "$ref": "#/$defs/nonEmpty"
          },
          "estimated_minutes": {
            "type": "integer",
            "minimum": 5,
            "maximum": 180
          },
          "required": {
            "type": "boolean"
          },
          "completion_rule": {
            "enum": ["confirmation", "valid_submission", "deterministic_pass", "runner_pass"]
          },
          "source_ids": {
            "$ref": "#/$defs/idList"
          },
          "submission_fields": {
            "type": "array",
            "items": {
              "type": "object",
              "additionalProperties": false,
              "required": ["id", "kind", "label", "required", "min_length", "max_length"],
              "properties": {
                "id": {
                  "$ref": "#/$defs/stableId"
                },
                "kind": {
                  "enum": ["text", "code", "choice", "confirmation"]
                },
                "label": {
                  "$ref": "#/$defs/nonEmpty"
                },
                "required": {
                  "type": "boolean"
                },
                "min_length": {
                  "type": "integer",
                  "minimum": 0,
                  "maximum": 20000
                },
                "max_length": {
                  "type": "integer",
                  "minimum": 1,
                  "maximum": 20000
                },
                "options": {
                  "type": "array",
                  "minItems": 2,
                  "uniqueItems": true,
                  "items": {
                    "type": "string",
                    "minLength": 1
                  }
                }
              }
            }
          },
          "deterministic_check": {
            "type": "object",
            "additionalProperties": false,
            "required": ["field_id", "accepted_values", "feedback"],
            "properties": {
              "field_id": {
                "$ref": "#/$defs/stableId"
              },
              "accepted_values": {
                "type": "array",
                "minItems": 1,
                "uniqueItems": true,
                "items": {
                  "type": "string",
                  "minLength": 1
                }
              },
              "feedback": {
                "$ref": "#/$defs/nonEmpty"
              }
            }
          },
          "runner_task_id": {
            "$ref": "#/$defs/stableId"
          },
          "capability_ids": {
            "$ref": "#/$defs/idList"
          },
          "activity_roles": {
            "type": "array",
            "minItems": 1,
            "uniqueItems": true,
            "items": {
              "enum": ["study", "active_recall", "structured_check", "correction", "proof", "runner_cpp", "runner_python", "transfer", "project", "review"]
            }
          },
          "language": {
            "enum": ["none", "cpp", "python", "bilingual"]
          },
          "evidence_ceiling": {
            "enum": ["none", "limited", "supported", "retained_limited", "verified", "retained"]
          }
        }
      }
    },
    "diagnostic_remediation_rules": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id",
          "question_id",
          "response_values",
          "activity_ids",
          "reason"
        ],
        "properties": {
          "id": {
            "$ref": "#/$defs/stableId"
          },
          "question_id": {
            "$ref": "#/$defs/stableId"
          },
          "response_values": {
            "type": "array",
            "minItems": 1,
            "uniqueItems": true,
            "items": {
              "type": "string",
              "minLength": 1
            }
          },
          "activity_ids": {
            "$ref": "#/$defs/idList"
          },
          "reason": {
            "$ref": "#/$defs/nonEmpty"
          }
        }
      }
    }
  },
  "$defs": {
    "stableId": {
      "type": "string",
      "pattern": "^[a-z][a-z0-9-]*$"
    },
    "version": {
      "type": "string",
      "pattern": "^(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)$"
    },
    "nonEmpty": {
      "type": "string",
      "minLength": 1
    },
    "idList": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {
        "$ref": "#/$defs/stableId"
      }
    }
  }
}
