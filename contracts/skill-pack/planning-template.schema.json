{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://local.cloud-study/contracts/skill-pack/planning-template.schema.json",
  "title": "Deterministic planning preview template",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "id",
    "skill_id",
    "skill_version",
    "title",
    "rationale",
    "limitations",
    "units"
  ],
  "properties": {
    "schema_version": {
      "const": "1.0.0"
    },
    "id": {
      "type": "string",
      "pattern": "^[a-z][a-z0-9-]*$"
    },
    "skill_id": {
      "type": "string",
      "pattern": "^[a-z][a-z0-9-]*$"
    },
    "skill_version": {
      "type": "string"
    },
    "title": {
      "type": "string",
      "minLength": 1
    },
    "rationale": {
      "type": "string",
      "minLength": 1
    },
    "limitations": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "units": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id",
          "title",
          "objective",
          "reason",
          "estimated_minutes",
          "completion_criteria",
          "source_ids"
        ],
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^[a-z][a-z0-9-]*$"
          },
          "title": {
            "type": "string",
            "minLength": 1
          },
          "objective": {
            "type": "string",
            "minLength": 1
          },
          "reason": {
            "type": "string",
            "minLength": 1
          },
          "estimated_minutes": {
            "type": "integer",
            "minimum": 15,
            "maximum": 180
          },
          "completion_criteria": {
            "type": "array",
            "minItems": 1,
            "items": {
              "type": "string",
              "minLength": 1
            }
          },
          "source_ids": {
            "type": "array",
            "minItems": 1,
            "uniqueItems": true,
            "items": {
              "type": "string"
            }
          }
        }
      }
    }
  }
}
