{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://local.cloud-study/contracts/skill-pack/diagnostic-definition.schema.json",
  "title": "Skill package diagnostic definition",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "id",
    "skill_id",
    "skill_version",
    "start_question_id",
    "questions"
  ],
  "properties": {
    "schema_version": {
      "const": "1.0.0"
    },
    "id": {
      "type": "string",
      "pattern": "^[a-z][a-z0-9-]*$"
    },
    "skill_id": {
      "type": "string",
      "pattern": "^[a-z][a-z0-9-]*$"
    },
    "skill_version": {
      "type": "string",
      "pattern": "^(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)$"
    },
    "start_question_id": {
      "type": "string",
      "pattern": "^[a-z][a-z0-9-]*$"
    },
    "questions": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "prompt", "reason", "response_type", "transitions"],
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^[a-z][a-z0-9-]*$"
          },
          "prompt": {
            "type": "string",
            "minLength": 1
          },
          "reason": {
            "type": "string",
            "minLength": 1
          },
          "response_type": {
            "enum": ["free_text", "code_text", "single_choice"]
          },
          "options": {
            "type": "array",
            "minItems": 2,
            "uniqueItems": true,
            "items": {
              "type": "object",
              "additionalProperties": false,
              "required": ["value", "label"],
              "properties": {
                "value": {
                  "type": "string",
                  "pattern": "^[a-z][a-z0-9-]*$"
                },
                "label": {
                  "type": "string",
                  "minLength": 1
                }
              }
            }
          },
          "transitions": {
            "type": "object",
            "additionalProperties": false,
            "required": ["answered", "skipped", "uncertain"],
            "properties": {
              "answered": {
                "type": ["string", "null"]
              },
              "skipped": {
                "type": ["string", "null"]
              },
              "uncertain": {
                "type": ["string", "null"]
              }
            }
          }
        },
        "allOf": [
          {
            "if": {
              "properties": {
                "response_type": {
                  "const": "single_choice"
                }
              }
            },
            "then": {
              "required": ["options"]
            },
            "else": {
              "not": {
                "required": ["options"]
              }
            }
          }
        ]
      }
    }
  }
}
