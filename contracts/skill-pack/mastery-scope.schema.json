{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://local.cloud-study/contracts/skill-pack/mastery-scope.schema.json",
  "title": "Skill package mastery scope",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "id",
    "skill_id",
    "skill_version",
    "scope_statement",
    "dimensions",
    "allowed_evidence_levels",
    "prohibited_claims",
    "limitations"
  ],
  "properties": {
    "schema_version": {
      "const": "1.0.0"
    },
    "id": {
      "$ref": "#/$defs/stableId"
    },
    "skill_id": {
      "$ref": "#/$defs/stableId"
    },
    "skill_version": {
      "$ref": "#/$defs/version"
    },
    "scope_statement": {
      "type": "string",
      "minLength": 1
    },
    "dimensions": {
      "type": "array",
      "minItems": 6,
      "maxItems": 6,
      "uniqueItems": true,
      "items": {
        "enum": ["understanding", "operation", "transfer", "artifact", "retention", "correction"]
      }
    },
    "allowed_evidence_levels": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {
        "enum": ["limited", "supported", "retained_limited", "verified", "retained"]
      }
    },
    "prohibited_claims": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {
        "enum": ["scope_criteria_met", "verified", "retained", "mastered"]
      }
    },
    "limitations": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "string",
        "minLength": 1
      }
    }
  },
  "$defs": {
    "stableId": {
      "type": "string",
      "pattern": "^[a-z][a-z0-9-]*$"
    },
    "version": {
      "type": "string",
      "pattern": "^(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)$"
    }
  }
}
