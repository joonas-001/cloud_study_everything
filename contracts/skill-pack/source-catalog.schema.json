{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://local.cloud-study/contracts/skill-pack/source-catalog.schema.json",
  "title": "Skill package source catalog",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "skill_id", "skill_version", "sources", "experts"],
  "properties": {
    "schema_version": {
      "const": "1.0.0"
    },
    "skill_id": {
      "type": "string",
      "pattern": "^[a-z][a-z0-9-]*$"
    },
    "skill_version": {
      "type": "string",
      "pattern": "^(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)$"
    },
    "sources": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id",
          "title",
          "publisher",
          "url",
          "source_type",
          "authority_tier",
          "authority_rationale",
          "retrieved_at",
          "check_mode",
          "access_note"
        ],
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^[a-z][a-z0-9-]*$"
          },
          "title": {
            "type": "string",
            "minLength": 1
          },
          "publisher": {
            "type": "string",
            "minLength": 1
          },
          "url": {
            "type": "string",
            "format": "uri"
          },
          "source_type": {
            "enum": [
              "official_documentation",
              "university_course",
              "textbook",
              "standard",
              "peer_reviewed_research",
              "government_guidance"
            ]
          },
          "authority_tier": {
            "type": "integer",
            "minimum": 1,
            "maximum": 5
          },
          "authority_rationale": {
            "type": "string",
            "minLength": 1
          },
          "published_version": {
            "type": "string",
            "minLength": 1
          },
          "published_at": {
            "type": "string",
            "format": "date"
          },
          "retrieved_at": {
            "type": "string",
            "format": "date"
          },
          "check_mode": {
            "enum": ["http_metadata", "manual"]
          },
          "access_note": {
            "type": "string",
            "minLength": 1
          }
        }
      }
    },
    "experts": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "name", "expertise_evidence", "source_ids", "planning_principles"],
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^[a-z][a-z0-9-]*$"
          },
          "name": {
            "type": "string",
            "minLength": 1
          },
          "expertise_evidence": {
            "type": "string",
            "minLength": 1
          },
          "source_ids": {
            "type": "array",
            "minItems": 1,
            "uniqueItems": true,
            "items": {
              "type": "string"
            }
          },
          "planning_principles": {
            "type": "array",
            "minItems": 1,
            "items": {
              "type": "string",
              "minLength": 1
            }
          }
        }
      }
    }
  }
}
