{
  "policy_id": "single-user-singapore",
  "version": "1.0.0",
  "status": "confirmed",
  "authorization": {
    "code_implementation": true,
    "cloud_resource_creation": true,
    "paid_service": true,
    "public_release": false
  },
  "access": {
    "audience": "owner_only",
    "registration": "disabled",
    "host_independent": true,
    "ingress": "tailscale_serve_private",
    "custom_domain": false
  },
  "identity": {
    "provider": "microsoft_personal",
    "allowlist_size": 1,
    "login_source": "runtime_secret",
    "password_database": false
  },
  "platform": {
    "provider": "tencent_cloud",
    "product": "lighthouse",
    "region": "singapore",
    "country_code": "SG",
    "topology": "single_instance",
    "instance": {
      "vcpu": 2,
      "memory_gib": 2,
      "system_disk_gib": 40,
      "monthly_transfer_gib": 512
    }
  },
  "runtime": {
    "node_major": 24,
    "python": "3.14.3",
    "package_manager": "pnpm",
    "python_manager": "uv"
  },
  "budget": {
    "currency": "CNY",
    "monthly_hard_limit": 50,
    "expected_monthly": 32,
    "alert_percentages": [
      50,
      80
    ],
    "automatic_top_up": false,
    "automatic_scaling": false,
    "unknown_price_action": "stop",
    "checkout_reconfirmation_required": true
  },
  "storage": {
    "database": "sqlite",
    "persistence": "single_instance_persistent_disk",
    "managed_database_todo": true
  },
  "runner": {
    "remote_enabled": false,
    "local_history_preserved": true,
    "future_enablement_requires_separate_authorization": true
  },
  "external_calls": {
    "enabled_by_default": false,
    "real_ai": false,
    "real_sources": false,
    "email": false
  },
  "backup": {
    "frequency": "daily",
    "daily_retention": 7,
    "weekly_retention": 4,
    "encryption": "rsa_oaep_aes_256_gcm",
    "private_key_location": "offline_owner_controlled",
    "rpo_hours": 24,
    "rto_hours": 4,
    "restore_drill": "before_preview_then_quarterly"
  },
  "logs": {
    "operations_retention_days": 7,
    "sensitive_body_logging": false,
    "product_audit_history": "preserve"
  },
  "sources": [
    {
      "id": "tencent-lighthouse-pricing",
      "publisher": "腾讯云",
      "url": "https://cloud.tencent.com/document/product/1207/73452/",
