# 6D 所有者单用户受控上线模板；不要提交真实邮箱、tailnet 地址或凭据。
CLOUD_STUDY_DEPLOYMENT_MODE=private_preview
CLOUD_STUDY_DEPLOYMENT_POLICY_PATH=/opt/cloud-study/app/deployment/policies/single-user-singapore-v2.json
CLOUD_STUDY_DATABASE_PATH=/var/lib/cloud-study/cloud-study.db
CLOUD_STUDY_CREDENTIAL_STORE=file
CLOUD_STUDY_SECRET_DIRECTORY=/etc/cloud-study/secrets
CLOUD_STUDY_BACKUP_PUBLIC_KEY=/etc/cloud-study/backup-public.pem
CLOUD_STUDY_OWNER_LOGIN=owner@example.invalid
CLOUD_STUDY_ALLOWED_ORIGIN=https://cloud-study.example-tailnet.ts.net
CLOUD_STUDY_RUNNER_SOCKET=/run/cloud-study-runner/runner.sock
NEXT_PUBLIC_API_BASE_URL=/api
CLOUD_STUDY_API_INTERNAL_URL=http://127.0.0.1:8000
NEXT_TELEMETRY_DISABLED=1
